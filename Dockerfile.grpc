# Dockerfile.grpc

FROM python:3.10-slim-buster

# Establecer el WORKDIR en el directorio raíz para controlar mejor la estructura de archivos
WORKDIR /

# Crear la estructura de directorios necesaria: /app/app
RUN mkdir -p /app/app

# Copiar requirements.txt a /app/requirements.txt
COPY app/requirements.txt /app/requirements.txt

# Instalar herramientas para la limpieza y diagnóstico, incluyendo 'file' explícitamente
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl dos2unix file && \
    rm -rf /var/lib/apt/lists/*

# Instalar dependencias de Python
RUN pip install --no-cache-dir -r /app/requirements.txt

# PASO DE DIAGNÓSTICO: Verificar si grpcio-tools se instaló correctamente
RUN pip show grpcio-tools

# Crear la estructura de directorios para los archivos .proto de Google
RUN mkdir -p /google/protobuf/

# Descargar los archivos .proto de Google necesarios
RUN curl -o /google/protobuf/empty.proto https://raw.githubusercontent.com/protocolbuffers/protobuf/main/src/google/protobuf/empty.proto
RUN curl -o /google/protobuf/timestamp.proto https://raw.githubusercontent.com/protocolbuffers/protobuf/main/src/google/protobuf/timestamp.proto

# --- Nuevo: Copiar productos.proto a un directorio accesible para la generación ---
COPY app/productos.proto /app/productos.proto

# --- Generar los stubs de gRPC en /app/app/ ---
# Esto genera productos_pb2.py y productos_pb2_grpc.py en /app/app/
RUN python -m grpc_tools.protoc \
    -I/app \
    -I/google/protobuf \
    --python_out=/app/app \
    --grpc_python_out=/app/app \
    /app/productos.proto

# --- ZONA CRÍTICA: Copiar app_grpc_server.py y realizar SOLO limpieza básica ---
# Copia el archivo desde el host.
COPY app/app_grpc_server.py /app/app/app_grpc_server.py

# Limpieza de BOM y CRLF solamente. NO SE TOCA LA INDENTACIÓN.
RUN echo "Limpiando app_grpc_server.py (removiendo BOM y CRLF)..." && \
    dos2unix /app/app/app_grpc_server.py && \
    sed -i '1s/^\xef\xbb\xbf//' /app/app/app_grpc_server.py && \
    chmod +x /app/app/app_grpc_server.py && \
    echo "Verificando app_grpc_server.py después de la limpieza (file, hexdump, py_compile):" && \
    file /app/app/app_grpc_server.py && \
    echo "Primeras 10 líneas con hexdump:" && \
    hexdump -C /app/app/app_grpc_server.py | head -n 10 && \
    echo "Últimas 10 líneas con hexdump (para verificar fin de archivo):" && \
    hexdump -C /app/app/app_grpc_server.py | tail -n 10 && \
    echo "Prueba de sintaxis de Python:" && \
    python -m py_compile /app/app/app_grpc_server.py || exit 1

# Comando para ejecutar el servidor gRPC
# ENTRYPOINT ["python", "-u", "/app/app/app_grpc_server.py"] # Ya está definido en docker-compose