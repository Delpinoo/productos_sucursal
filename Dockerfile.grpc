# Dockerfile.grpc

FROM python:3.10-slim-buster

WORKDIR /app

# Copia requirements.txt desde app/ en el contexto de construcción a la raíz de /app en el contenedor
COPY app/requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Instala curl para descargar los archivos .proto de Google
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Crea la estructura de directorios para los archivos .proto de Google
RUN mkdir -p google/protobuf/

# Descarga los archivos .proto de Google necesarios
RUN curl -o google/protobuf/empty.proto https://raw.githubusercontent.com/protocolbuffers/protobuf/main/src/google/protobuf/empty.proto
RUN curl -o google/protobuf/timestamp.proto https://raw.githubusercontent.com/protocolbuffers/protobuf/main/src/google/protobuf/timestamp.proto

# Copia tu archivo productos.proto desde app/ en el contexto de construcción a la raíz de /app en el contenedor
COPY app/productos.proto .

# Genera los archivos Python de Protobuf
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. productos.proto

# Mueve los archivos generados a la subcarpeta 'app' dentro del WORKDIR del contenedor
# Esto es crucial para que Python los encuentre como 'app.productos_pb2', etc.
RUN mkdir -p app
RUN mv productos_pb2.py ./app/
RUN mv productos_pb2_grpc.py ./app/
RUN mv productos.proto ./app/

# Copia el servidor gRPC y el archivo __init__.py desde app/ en el host a /app/app en el contenedor
COPY app/app_grpc_server.py ./app/
COPY app/__init__.py ./app/

# Copia el archivo .env desde la raíz del contexto de construcción a la raíz de /app en el contenedor
COPY .env .

# La línea 'COPY init.sql .' ha sido eliminada de aquí.
# Ahora init.sql se montará directamente mediante docker-compose.yml.

# Establece la variable de entorno PYTHONPATH para que Python encuentre los módulos en /app
ENV PYTHONPATH=/app

# Expone el puerto que usará el servidor gRPC
EXPOSE 50051

# Comando para ejecutar el servidor gRPC al iniciar el contenedor
# Usa '-m app.app_grpc_server' para ejecutarlo como un módulo, lo que ayuda con la resolución de rutas internas.
CMD ["python", "-u", "app.app_grpc_server"]
