# Dockerfile.grpc

# Utiliza la imagen base de Python 3.10 slim (más pequeña y compatible)
FROM python:3.10-slim-buster

# Establece el directorio de trabajo base dentro del contenedor a /app.
# Todos los COPY y RUN subsiguientes serán relativos a este directorio.
WORKDIR /app

# Copia solo el archivo requirements.txt desde tu carpeta 'app/' local
# a la raíz del WORKDIR del contenedor (es decir, a /app/requirements.txt).
COPY app/requirements.txt .

# Instala las dependencias listadas en requirements.txt.
RUN pip install --no-cache-dir -r requirements.txt

# Copia TODO el contenido de la carpeta 'app/' local
# (que ahora DEBE CONTENER productos.proto, app_grpc_server.py, __init__.py)
# directamente a la raíz del WORKDIR del contenedor (/app/).
COPY app/ .

# Copia el archivo .env desde la raíz de tu proyecto local a la raíz del WORKDIR del contenedor (/app/.env).
COPY .env .

# --- PASO DE DEPURACIÓN EN CONSTRUCCIÓN (se mantienen para verificación) ---
# Listar el contenido del directorio /app ANTES de la generación de protobuf.
# Estos comandos se ejecutarán durante la fase de 'Building' del docker compose.
RUN echo "--- Contenido de /app antes de protoc (tras COPY) ---" && ls -l /app

# Generar los archivos _pb2.py y _pb2_grpc.py dentro del contenedor.
# Como productos.proto ahora está directamente en /app, el comando es directo.
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. productos.proto

# Listar el contenido del directorio /app DESPUÉS de la generación de protobuf.
RUN echo "--- Contenido de /app después de protoc (tras generación) ---" && ls -l /app

# Prueba de importación durante la construcción para confirmar la generación.
# Si esto falla, el problema es durante la construcción de la imagen.
RUN python -c "import productos_pb2; import productos_pb2_grpc; print('Protobuf files imported successfully during build time.')"
# --- FIN PASOS DE DEPURACIÓN EN CONSTRUCCIÓN ---

# Añade el WORKDIR (/app) al PYTHONPATH del contenedor. Esto es crucial.
ENV PYTHONPATH=/app

# --- LÓGICA DE EJECUCIÓN DEL SERVIDOR (simplificada y directa) ---
# Define el comando para ejecutar el servidor gRPC.
# Ejecutamos el archivo directamente con 'python' ya que /app está en PYTHONPATH.
CMD ["python", "app_grpc_server.py"]

# Expon el puerto donde el servidor gRPC escuchará las conexiones.
EXPOSE 50051
